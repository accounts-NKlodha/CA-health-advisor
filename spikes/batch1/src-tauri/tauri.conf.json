{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HY Spike Batch1",
  "version": "0.1.0",
  "identifier": "in.nklodha.hyspike.batch1",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": { "csp": null },
    "windows": [
      {
        "label": "control",
        "url": "control.html",
        "title": "HY Spike: batch 1",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,MediaFoundationVideoCapture",
        "width": 460,
        "height": 360,
        "resizable": true
      },
      {
        "label": "pet",
        "url": "pet.html",
        "title": "HY Pet",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,MediaFoundationVideoCapture",
        "width": 160,
        "height": 160,
        "x": 1100,
        "y": 500,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "fixedRuntime",
        "path": "./webview2-fixed/"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
