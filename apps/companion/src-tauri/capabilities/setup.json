{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "setup",
  "description": "The setup wizard (created on open, destroyed on close): the pet, workweek, water and reminder steps, a sample reminder, and Finish.",
  "windows": [
    "setup"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-settings-bootstrap",
    "allow-pet-edit",
    "allow-set-hotkey",
    "allow-bring-pet",
    "allow-setup-page",
    "allow-save-coach-settings",
    "allow-save-water-settings",
    "allow-save-workweek",
    "allow-setup-sample",
    "allow-setup-finish"
  ]
}
