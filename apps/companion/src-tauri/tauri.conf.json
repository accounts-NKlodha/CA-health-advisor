{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HealthierYou",
  "version": "0.1.0",
  "identifier": "app.healthieryou.companion",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src blob:; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "capabilities": [
        "pet",
        "panel",
        "screens",
        "review",
        "plan",
        "setup",
        "camera"
      ]
    },
    "windows": []
  },
  "bundle": {
    "active": false,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "customLanguageFiles": {
          "English": "./windows/English.nsh"
        },
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "publisher": "HealthierYou",
    "shortDescription": "HealthierYou desktop companion"
  }
}
