{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HealthierYou",
  "version": "0.1.0",
  "identifier": "app.healthieryou.companion",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    },
    "windows": [
      {
        "label": "screens",
        "url": "screens.html",
        "title": "HealthierYou",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection",
        "width": 480,
        "height": 360,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
